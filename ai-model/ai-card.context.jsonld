{
  "_comment": [
    "JSON-LD context for the CVDLINK AI Card. The generator embeds this into every",
    "generated .jsonld, so there is nothing to host and nothing to fetch at read time.",
    "",
    "@vocab means every field not listed below still gets a real IRI under the CVDLINK",
    "namespace, so no part of the card is lost from the graph. The explicit mappings are",
    "the fields where a widely-used term clearly fits; everything else stays a CVDLINK",
    "term until there is a reason to map it.",
    "",
    "To use richer vocabulary later (AIRO/DPV for the risk and AI-Act parts), change the",
    "mappings here and regenerate. The generator does not need to change."
  ],

  "@context": {
    "@vocab": "https://cvdlink.github.io/ns/ai-card#",
    "cvd": "https://cvdlink.github.io/ns/ai-card#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "ai": "https://w3id.org/dpv/ai#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "ai_techniques": "ai:hasTechnique",

    "system_name": "schema:name",
    "short_title": "schema:alternateName",
    "short_description": "schema:description",
    "version": "schema:softwareVersion",
    "keywords": "schema:keywords",
    "domain": "schema:applicationCategory",

    "card_publisher": "dcterms:publisher",
    "card_language": "dcterms:language",
    "card_version": "schema:version",
    "card_date": { "@id": "dcterms:created", "@type": "xsd:date" },

    "providers": "schema:provider",
    "developers": "schema:author",
    "contacts": "schema:contactPoint",
    "name": "schema:name",
    "institution": "schema:affiliation",
    "email": "schema:email",
    "orcid": { "@id": "schema:identifier", "@type": "@id" },
    "funding": "schema:funding",
    "paper_url": { "@id": "schema:citation", "@type": "@id" },

    "datasets": "schema:dataset",
    "description": "dcterms:description",
    "documentation_link": { "@id": "schema:documentation", "@type": "@id" },
    "location_or_request": { "@id": "dcat:accessURL", "@type": "@id" },

    "code_license": "schema:license",
    "purpose": "schema:applicationSubCategory"
  }
}
